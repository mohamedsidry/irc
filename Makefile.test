NAME = a.test
CXX = c++
CXXVERSION = -std=c++98
CXXFLAGS = -Wall -Werror -Wextra -pedantic


# STYLE AND COLORS
RED = \033[1;31m
GREEN = \033[1;32m
YELLOW = \033[1;33m
PURPLE = \033[1;34m
RESET = \033[0m


# SOURCES
BUILD_DIR = build.test
HPP =	include/main.hpp \
		include/test.hpp \
		include/Utils.hpp \
		include/Client.hpp \
		include/Exception.hpp \
		include/IllegalArgumentException.hpp \
		include/Tester.hpp \
		include/ClientRepository.hpp \
        include/IClientManagment.hpp \
        include/ISearchableClient.hpp \
		include/ClientService.hpp


MAIN =	tests/main.cpp 

SRCS =	$(MAIN) \
		tests/Tester.cpp \
		srcs/helpers/Utils.cpp \
		srcs/server/models/Client.cpp \
		srcs/server/repositories/ClientRepository.cpp \
		srcs/server/services/ClientService.cpp

OBJS = $(SRCS:%.cpp=$(BUILD_DIR)/%.o)

all : $(NAME)

$(NAME) : $(OBJS)
	@printf "$(YELLOW) Building : $(PURPLE)%s$(RESET)\n" $@
	@$(CXX) $(CXXVERSION) $(CXXFLAGS) $(OBJS) -o $@



$(BUILD_DIR)/%.o: %.cpp $(HPP)
	@mkdir -p $(dir $@)
	@printf "$(YELLOW) Compile :  $(PURPLE)%s$(RESET)\n" $<
	@$(CXX) $(CXXVERSION) $(CXXFLAGS) -Iinclude -c $< -o $@


clean:
	@printf "$(YELLOW) remove :  $(PURPLE)%s$(RESET)\n" $(OBJS)
	@rm -fr $(OBJS) $(BUILD_DIR)


fclean: clean
	@printf "$(YELLOW) remove :  $(PURPLE)%s$(RESET)\n" $(OBJS)
	@rm -fr $(NAME)


run : $(NAME)
	@printf "$(YELLOW) RUNNING TEST :  $(PURPLE)./%s$(RESET)\n" $<
	@./$<


re : fclean all


.PHONY: all clean fclean re