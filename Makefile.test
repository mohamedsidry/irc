NAME = a.test
CXX = c++
CXXVERSION = -std=c++98
CXXFLAGS = -Wall -Werror -Wextra -pedantic


# STYLE AND COLORS
RED = \033[1;31m
GREEN = \033[1;32m
YELLOW = \033[1;33m
PURPLE = \033[1;34m
RESET = \033[0m


# SOURCES
BUILD_DIR = build.test

#include/ChannelData.hpp \
#include/Channel.hpp \
#include/ChannelMetaData.hpp \
#include/ChannelMetaDataService.hpp \
#include/ChannelMode.hpp \
#include/ChannelModeService.hpp \
#include/ChannelServices.hpp \

HPP =	include/AUser.hpp \
		include/Client.hpp \
		include/ClientsRepository.hpp \
		include/ClientsService.hpp \
		include/Config.hpp \
		include/Exception.hpp \
		include/IllegalArgumentException.hpp \
		include/IUsersManagment.hpp \
		include/main.hpp \
		include/Moderator.hpp \
		include/ModeratorsRepository.hpp \
		include/ModeratorsService.hpp \
		include/Subscriber.hpp \
		include/SubscribersRepository.hpp \
		include/SubscribersService.hpp \
		include/Tester.hpp \
		include/test.hpp \
		include/Utils.hpp

MAIN =	tests/main.cpp 

#srcs/server/models/ChannelData.cpp \
#srcs/server/models/Channel.cpp \
#srcs/server/models/ChannelMetaData.cpp \
#srcs/server/models/ChannelMode.cpp \
#srcs/server/services/ChannelMetaDataService.cpp \
#srcs/server/services/ChannelModeService.cpp \
#srcs/server/services/ChannelServices.cpp \

SRCS =	$(MAIN) \
		srcs/helpers/Utils.cpp \
		srcs/server/Config.cpp \
		srcs/server/models/AUser.cpp \
		srcs/server/models/Client.cpp \
		srcs/server/models/Moderator.cpp \
		srcs/server/models/Subscriber.cpp \
		srcs/server/repositories/ClientsRepository.cpp \
		srcs/server/repositories/ModeratorsRepository.cpp \
		srcs/server/repositories/SubscribersRepository.cpp \
		srcs/server/services/ClientsService.cpp \
		srcs/server/services/ModeratorsService.cpp \
		srcs/server/services/SubscribersService.cpp \
		tests/Tester.cpp

OBJS = $(SRCS:%.cpp=$(BUILD_DIR)/%.o)

all : $(NAME)

$(NAME) : $(OBJS)
	@printf "$(YELLOW) Building : $(PURPLE)%s$(RESET)\n" $@
	@$(CXX) $(CXXVERSION) $(CXXFLAGS) $(OBJS) -o $@



$(BUILD_DIR)/%.o: %.cpp $(HPP)
	@mkdir -p $(dir $@)
	@printf "$(YELLOW) Compile :  $(PURPLE)%s$(RESET)\n" $<
	@$(CXX) $(CXXVERSION) $(CXXFLAGS) -Iinclude -c $< -o $@


clean:
	@printf "$(YELLOW) remove :  $(PURPLE)%s$(RESET)\n" $(OBJS)
	@rm -fr $(OBJS) $(BUILD_DIR)


fclean: clean
	@printf "$(YELLOW) remove :  $(PURPLE)%s$(RESET)\n" $(OBJS)
	@rm -fr $(NAME)


run : $(NAME)
	@printf "$(YELLOW) RUNNING TEST :  $(PURPLE)./%s$(RESET)\n" $<
	@./$<


re : fclean all


.PHONY: all clean fclean re